{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/vite-env.d.ts",
    "src/types/**/*.ts",
    "src/boards/**/*.ts",
    "src/catalog/index.ts",
    "src/core/constants.ts",
    "src/core/proposal.ts",
    "src/core/code-profiles.ts",
    "src/core/code-blocks-sram.ts",
    "src/core/code-blocks.ts",
    "src/core/docs-discovery.ts",
    "src/core/netlist.ts",
    "src/core/selftest.ts",
    "src/core/document.ts",
    "src/core/persistence.ts",
    "src/core/state.ts",
    "src/core/hardware.ts",
    "src/core/hardware/**/*.ts",
    "src/i18n/**/*.ts",
    "src/store/**/*.ts",
    "src/services/**/*.ts",
    "src/workspaces/**/*.ts",
    "src/ui/code-blocks-panel.ts",
    "src/ui/inspector.ts",
    "src/ui/inspector/**/*.ts",
    "src/ui/modals/about.ts",
    "src/ui/modals/svg-library.ts",
    "src/ui/workbench/shared.ts",
    "src/ui/modals/settings.ts"
  ]
}
