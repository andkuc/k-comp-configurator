# Copy to .env inside server/compile-service/ if you want custom settings.
# Never commit .env to Git (ignored via .gitignore).

# Bind address & host port (keep 127.0.0.1 for local-only use)
COMPILE_BIND_ADDR=127.0.0.1
COMPILE_PORT=8787

# Concurrency & cache sizing
MAX_CONCURRENT_BUILDS=2
MAX_QUEUE_LENGTH=24
MAX_CACHE_ENTRIES=128

# Allowed browser origins (* for local testing; restrict to your Pages URL for remote servers)
CORS_ORIGINS=*

# Optional Bearer token (REQUIRED when using docker-compose.prod.yml or exposing over a network)
AUTH_TOKEN=

# Only required for docker-compose.prod.yml (Caddy Auto-HTTPS)
COMPILE_DOMAIN=compile.example.org
